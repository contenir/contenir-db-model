{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "timeout": 10,
    "threads": "max",
    "logs": {
        "text": "infection.log",
        "summary": "summary.log",
        "stryker": {
            "badge": "/^(main|master)$/"
        }
    },
    "mutators": {
        "@default": true,
        // PropertyAccessor memoises ReflectionProperty objects. Dropping the
        // memoisation only costs time, so no test can observe it.
        "AssignCoalesce": {
            "ignoreSourceCodeByRegex": [".*\\$this->properties\\[.*"]
        }
    },
    "staticAnalysisTool": "mago"
}
