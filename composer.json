{
    "name": "contenir/contenir-db-model",
    "description": "Attribute-mapped, typed-property data mapper built on php-db/phpdb",
    "license": "BSD-3-Clause",
    "type": "library",
    "keywords": [
        "contenir",
        "php-db",
        "data-mapper",
        "orm",
        "repository"
    ],
    "homepage": "https://contenir.com.au",
    "support": {
        "docs": "https://docs.contenir.com.au/contenir-db-model/",
        "issues": "https://github.com/contenir/contenir-db-model/issues",
        "source": "https://github.com/contenir/contenir-db-model"
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "php-db/phpdb": "0.6.x-dev",
        "psr/container": "^1.1 || ^2.0",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "php-db/phpdb-mysql": "^0.4.0",
        "php-db/phpdb-pgsql": "0.1.x-dev",
        "php-db/phpdb-qa-tools": "0.1.x-dev",
        "php-db/phpdb-sqlite": "^0.2.0",
        "phpunit/phpunit": "^11.5.42"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Contenir\\Db\\Model\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ContenirTest\\Db\\Model\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.99"
        },
        "sort-packages": true
    },
    "extra": {
        "laminas": {
            "component": "Contenir\\Db\\Model",
            "config-provider": "Contenir\\Db\\Model\\ConfigProvider"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test",
            "@test-integration"
        ],
        "cs-check": [
            "mago format --check",
            "mago lint"
        ],
        "cs-fix": [
            "mago format",
            "mago lint --fix"
        ],
        "static-analysis": "mago analyze",
        "test": "phpunit --colors=always --testsuite unit",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "test-integration": "phpunit --colors=always --testsuite integration",
        "test-coverage-branches": "@php bin/coverage-branches.php"
    },
    "scripts-descriptions": {
        "test-coverage-branches": "Line, branch and path coverage across both suites (needs Xdebug); works around Xdebug path-coverage crashes"
    }
}
